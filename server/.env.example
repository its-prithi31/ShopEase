# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/shopease
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopease?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/shopease

# Secret key for JWT signing & verification
JWT_SECRET=shopease_jwt_secret_key_12345_secure
